{
   "name": "moesa-panel-app",
   "version": "1.5.3-alpha.1",
   "type": "module",
   "packageManager": "pnpm@10.33.0",
   "scripts": {
      "dev": "pnpm dev:supabase-types && pnpm dev:vue",
      "dev:vue": "vite --host",
      "dev:supabase": "supabase start --ignore-health-check",
      "dev:supabase-types": "supabase gen types typescript --local --schema public,api > ../supabase/functions/_shared/database.types.ts",
      "dev:seed-story": "node ../scripts/seed-story.mjs",
      "dev:amazon-probe": "cd ../supabase/functions && deno task probe",
      "dev:supabase-reset": "supabase db reset && pnpm dev:seed-story && pnpm dev:supabase-types",
      "build": "vite build",
      "preview": "vite preview",
      "typecheck": "vue-tsc --build",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:scripts": "node --test ../scripts/seed-story.test.mjs",
      "lint": "eslint src tests",
      "commit": "cz",
      "i18n-extract": "vue-i18n-extract report",
      "i18n-build": "node src/script/translate-with-ollama.js",
      "lint:fix": "pnpm lint --fix",
      "prepare": "cd .. && husky app/.husky",
      "test:db": "cd ../supabase && supabase db reset && supabase test db",
      "i18n-sync": "node src/script/sync-locales.mjs"
   },
   "dependencies": {
      "@casl/ability": "^6.7.5",
      "@casl/vue": "^2.2.2",
      "@primeuix/themes": "^1.2.5",
      "@primevue/core": "^4.2.5",
      "@supabase/supabase-js": "^2.47.10",
      "@tanstack/vue-query": "^5.76.0",
      "@vueuse/core": "^11.3.0",
      "chart.js": "3.3.2",
      "countries-list": "^3.1.1",
      "dayjs": "^1.11.13",
      "deep-object-diff": "^1.1.9",
      "jwt-decode": "^4.0.0",
      "libphonenumber-js": "^1.12.6",
      "lodash": "^4.18.1",
      "lz-string": "^1.5.0",
      "pinia": "^2.3.0",
      "primeicons": "^7.0.0",
      "primelocale": "^2.1.7",
      "primevue": "^4.5.1",
      "quill": "^2.0.3",
      "vue": "^3.5.16",
      "vue-i18n": "^10.0.8",
      "vue-router": "^4.5.0",
      "vuedraggable": "4.1.0",
      "zod": "^4.6.7"
   },
   "devDependencies": {
      "@commitlint/cli": "^19.8.1",
      "@commitlint/config-conventional": "^19.8.1",
      "@primevue/auto-import-resolver": "^4.2.5",
      "@types/lodash": "^4.17.14",
      "@types/node": "^22.10.5",
      "@vitejs/plugin-vue": "^5.2.4",
      "@vue/eslint-config-prettier": "^10.2.0",
      "@vue/eslint-config-typescript": "^14.9.0",
      "@vue/test-utils": "^2.5.1",
      "@vue/tsconfig": "^0.9.1",
      "autoprefixer": "^10.4.20",
      "commitizen": "^4.3.1",
      "cz-conventional-changelog": "^3.3.0",
      "eslint": "^10.13.0",
      "eslint-plugin-vue": "^10.12.0",
      "globals": "^17.13.0",
      "happy-dom": "^21.0.4",
      "husky": "^9.1.7",
      "lint-staged": "^15.3.0",
      "postcss": "^8.4.49",
      "prettier": "^3.5.3",
      "release-please": "^16.15.0",
      "sass": "^1.83.1",
      "tailwindcss": "^3.4.17",
      "tailwindcss-primeui": "^0.3.4",
      "typescript": "^5.7.2",
      "unplugin-auto-import": "^0.18.6",
      "unplugin-vue-components": "^0.27.5",
      "vite": "^5.4.21",
      "vite-plugin-commonjs": "^0.10.4",
      "vite-plugin-compression": "^0.5.1",
      "vite-plugin-package-version": "^1.1.0",
      "vitest": "^3.2.7",
      "vue-i18n-extract": "^2.0.7",
      "vue-tsc": "^3.3.13"
   },
   "config": {
      "commitizen": {
         "path": "cz-conventional-changelog"
      }
   },
   "lint-staged": {
      "*.{js,cjs,mjs,ts,vue}": "eslint --fix",
      "*.{json,scss,css,md}": "prettier --write"
   }
}
