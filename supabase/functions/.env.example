# Amazon SP-API (Solution Provider Portal → your app client → "View" and "Authorize").
# Copy to supabase/functions/.env (git-ignored) for local Edge Functions. Do NOT push this file
# to the hosted project as-is: set the hosted secrets one by one with `supabase secrets set NAME=…`
# (production values, see supabase/README.md "Amazon (M22)").
AMAZON_SPAPI_LWA_CLIENT_ID=
AMAZON_SPAPI_LWA_CLIENT_SECRET=
AMAZON_SPAPI_REFRESH_TOKEN=
# Seller id used with the self-authorized token (sandbox only; production comes from OAuth).
AMAZON_SPAPI_SELLER_ID=
# Required, no default: `sandbox` (local dev, the static sandbox) or `production` (hosted). Left
# empty, every Amazon function answers amazon_unconfigured (fails closed).
AMAZON_SPAPI_ENV=
# eu | na | fe  (sandbox host: sandbox.sellingpartnerapi-<region>.amazon.com)
AMAZON_SPAPI_REGION=eu
# The SP-API application id (amzn1.sp.solution.…), used to build the consent URL.
AMAZON_SPAPI_APP_ID=
# true while the app is still a draft (adds version=beta to the consent URL).
AMAZON_SPAPI_APP_BETA=true
# Signs the OAuth state: at least 32 random bytes, base64 (e.g. `openssl rand -base64 32`).
AMAZON_SPAPI_STATE_SECRET=
# The panel's base URL (the OAuth callback redirects back here) and the project's public URL (the
# callback's redirect_uri and the public image links Amazon fetches). Required in production; in
# sandbox they default to http://localhost:6161 and http://127.0.0.1:54321.
APP_URL=
PUBLIC_SUPABASE_URL=
